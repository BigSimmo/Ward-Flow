# Optional. Must be on the fixed approved-account allowlist in config.mjs (currently only wflowdev7273a083aue);
# any other value is rejected, even if both variables agree.
# AZURE_STORAGE_ACCOUNT=wflowdev7273a083aue
AzureWebJobsStorage__accountName=wflowdev7273a083aue
# Replace both example UUIDs with the approved Entra tenant and user object IDs.
AZURE_TENANT_ID=00000000-0000-4000-8000-000000000000
WARD_ALLOWED_OBJECT_ID=00000000-0000-4000-8000-000000000001
# Set to true to permit any authenticated user in the approved tenant with WardFlow.Access:
WARD_ALLOW_TENANT_USERS=false
# Azure issues v2 API tokens to this application's client ID; never use a Graph token.
WARD_API_AUDIENCE=9b7b160d-9bc7-4712-b748-17ff3e70b706
# One exact approved frontend origin, no wildcard. Leave empty for non-browser clients.
WARD_ALLOWED_ORIGIN=
HOST=127.0.0.1
PORT=8787
# Optional: client ID of a user-assigned managed identity used for storage access.
# AZURE_CLIENT_ID=

# Shared synthetic workspace. Leave disabled until migrations, identity and networking pass.
WARD_SHARED_ENABLED=false
# Named Entra user object IDs; every assigned account has the one coordinator role.
# WARD_COORDINATOR_OBJECT_IDS=
# WARD_WORKSPACE_ID=
# Use the resource ID and matching host returned by azure-setup.mjs inspect/provision.
# WARD_PG_RESOURCE_ID=
# WARD_PG_HOST=
# WARD_PG_DATABASE=wardflow
# WARD_PG_USER=wardflow_backend
# Migration only, never run schema changes under the runtime app identity:
# WARD_MIGRATION_ADMIN_NAME=
# WARD_BACKEND_OBJECT_ID=
