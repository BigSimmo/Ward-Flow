# Primary default provider preset: dedicated Ward Flow synthetic Supabase project (zakzoemeedfepxcstsou).
# Never connect Ward Flow to PsychSift's Supabase or Railway resources.
WARD_DATABASE_PROVIDER=supabase
WARD_AUTH_PROVIDER=supabase

# Shared synthetic workspace. Leave disabled until migrations, identity and networking pass.
WARD_SHARED_ENABLED=false
# Explicit workspace data classification; live remains unavailable until commissioned.
WARD_DATA_MODE=prototype

# Dedicated Ward Flow Supabase settings (required when WARD_DATABASE_PROVIDER=supabase / WARD_AUTH_PROVIDER=supabase):
WARD_SUPABASE_PROJECT_REF=zakzoemeedfepxcstsou
WARD_SUPABASE_URL=https://zakzoemeedfepxcstsou.supabase.co
# Supply the restricted wardflow_backend session-pooler (:5432) or direct URL privately:
WARD_SUPABASE_DATABASE_URL=
# Publishable key only (sb_publishable_*); never a service-role or secret key:
WARD_SUPABASE_PUBLISHABLE_KEY=
# Optional CA bundle path when the project CA is not already in Node's trust store:
WARD_SUPABASE_CA_CERT_FILE=
# Migration CLI only (npm --prefix backend/ward-flow run migrate:supabase); never used at runtime:
# WARD_SUPABASE_MIGRATION_DATABASE_URL=

# Named Supabase Auth user UUIDs; every assigned account has the one coordinator role:
WARD_COORDINATOR_USER_IDS=
WARD_WORKSPACE_ID=

# One exact approved frontend origin, no wildcard. Leave empty for non-browser clients.
WARD_ALLOWED_ORIGIN=
HOST=127.0.0.1
PORT=8787

# Phone alerts (Web Push) for new act-now items. Off unless shared mode is on and all three are set.
# Generate a fresh pair locally (repository root): npm exec --prefix backend/ward-flow --offline -- web-push generate-vapid-keys --json
# The private key is a secret: keep it in private app settings or Key Vault, never in the repository or chat.
# WARD_FLOW_VAPID_PUBLIC_KEY=
# WARD_FLOW_VAPID_PRIVATE_KEY=
# A contact the push services can reach about this sender: mailto: or https: only.
# WARD_FLOW_VAPID_SUBJECT=mailto:

# -----------------------------------------------------------------------------
# Optional preset: Portable PostgreSQL (set WARD_DATABASE_PROVIDER=postgres)
# -----------------------------------------------------------------------------
# WARD_POSTGRES_DATABASE_URL=
# WARD_POSTGRES_CA_CERT_FILE=
# WARD_POSTGRES_MIGRATION_DATABASE_URL=

# -----------------------------------------------------------------------------
# Optional preset: Azure PostgreSQL / Entra (set WARD_DATABASE_PROVIDER=azure and WARD_AUTH_PROVIDER=entra)
# -----------------------------------------------------------------------------
# AZURE_STORAGE_ACCOUNT=wflowdev7273a083aue
# AzureWebJobsStorage__accountName=wflowdev7273a083aue
# AZURE_TENANT_ID=00000000-0000-4000-8000-000000000000
# WARD_ALLOWED_OBJECT_ID=00000000-0000-4000-8000-000000000001
# WARD_ALLOW_TENANT_USERS=false
# WARD_API_AUDIENCE=9b7b160d-9bc7-4712-b748-17ff3e70b706
# AZURE_CLIENT_ID=
# WARD_COORDINATOR_OBJECT_IDS=
# WARD_PG_RESOURCE_ID=
# WARD_PG_HOST=
# WARD_PG_DATABASE=wardflow_dev
# WARD_PG_USER=wardflow_backend
# WARD_MIGRATION_ADMIN_NAME=
# WARD_BACKEND_OBJECT_ID=
