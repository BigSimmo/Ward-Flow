{
  "name": "ward-flow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test backend.test.mjs shared-http.test.mjs supabase-auth.test.mjs traffic.test.mjs postgres.test.mjs push.test.mjs migrate.test.mjs postgres-preflight.test.mjs provider-portability.test.mjs provider-routing.test.mjs",
    "build:engine": "node build-engine.mjs",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "migrate:postgres": "node --env-file-if-exists=.env migrate-postgres.mjs",
    "migrate:supabase": "node --env-file-if-exists=.env migrate-supabase.mjs",
    "prune:receipts:supabase": "node --env-file-if-exists=.env prune-receipts.mjs",
    "prune:receipts:postgres": "node --env-file-if-exists=.env prune-receipts.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
