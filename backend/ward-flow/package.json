{
  "name": "ward-flow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node ../../scripts/run-backend-tests.mjs",
    "build:engine": "node build-engine.mjs",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "migrate:postgres": "node --env-file-if-exists=.env migrate-postgres.mjs",
    "migrate:supabase": "node --env-file-if-exists=.env migrate-supabase.mjs",
    "prune:postgres": "node --env-file-if-exists=.env prune-receipts.mjs postgres",
    "prune:supabase": "node --env-file-if-exists=.env prune-receipts.mjs supabase",
    "prune:receipts:postgres": "node --env-file-if-exists=.env prune-receipts.mjs postgres",
    "prune:receipts:supabase": "node --env-file-if-exists=.env prune-receipts.mjs supabase",
    "test:coverage": "node ../../scripts/run-backend-tests.mjs --coverage",
    "test:integration": "node ../../scripts/run-backend-tests.mjs --integration",
    "test:offline": "node ../../scripts/run-backend-tests.mjs --offline"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
