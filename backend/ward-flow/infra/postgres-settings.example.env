# Private backend configuration. Any PostgreSQL host with verified TLS.
WARD_DATABASE_PROVIDER=postgres
WARD_AUTH_PROVIDER=supabase
WARD_SHARED_ENABLED=true
# Demo controls (advance clock, reset or set scenario) on the shared board. Off unless true.
WARD_SHARED_DEMO_EVENTS=false
WARD_DATA_MODE=prototype
WARD_POSTGRES_DATABASE_URL=postgresql://wardflow_backend:<percent-encoded-password>@<database-host>:5432/<database-name>
# Optional: uncomment only when the server's CA is not already trusted by Node.
# WARD_POSTGRES_CA_CERT_FILE=<absolute-path-to-ca-bundle>
# Administrator-only setup file; remove this key from the runtime environment.
WARD_POSTGRES_MIGRATION_DATABASE_URL=postgresql://<administrator>:<percent-encoded-password>@<same-database-host>:5432/<same-database-name>
WARD_SUPABASE_PROJECT_REF=zakzoemeedfepxcstsou
WARD_SUPABASE_URL=https://zakzoemeedfepxcstsou.supabase.co
WARD_SUPABASE_PUBLISHABLE_KEY=<project-publishable-key>
WARD_COORDINATOR_USER_IDS=<verified-coordinator-user-uuid>
WARD_WORKSPACE_ID=<unique-synthetic-workspace-uuid>
WARD_ALLOWED_ORIGIN=<actual-project-verified-frontend-origin>
# Proxies whose X-Real-IP or X-Forwarded-For give the client address, comma separated.
# Use * on a host reachable only through its proxy (Railway). Leave empty when clients connect directly.
WARD_TRUSTED_PROXY_ADDRESSES=
HOST=127.0.0.1
PORT=8791
