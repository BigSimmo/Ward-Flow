# Public client configuration; no database secret or access token belongs here.
# Next.js embeds these at build time. Rebuild after applying the generated values.
# Feature environment: development, demo or production. When unset, a non-production
# NODE_ENV uses development defaults; NODE_ENV=production uses demo defaults, whether
# local or hosted. An unnamed production build still locks safeguard flags on;
# explicitly naming demo leaves them
# switchable on a device. Choose the mode deliberately for each public build.
# NEXT_PUBLIC_WARD_ENVIRONMENT=demo
# Optional registered flag overrides, comma separated: name=on,other=off.
# Device choices can override these in demo; production ignores device choices.
# NEXT_PUBLIC_WARD_FLAGS=
NEXT_PUBLIC_WARD_SHARED_ENABLED=false
NEXT_PUBLIC_WARD_AUTH_PROVIDER=supabase
NEXT_PUBLIC_WARD_SUPABASE_URL=https://zakzoemeedfepxcstsou.supabase.co
NEXT_PUBLIC_WARD_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_WARD_COORDINATOR_EMAIL=
# Shows the Create account link only when Supabase open sign-up is also on (H-0038).
# NEXT_PUBLIC_WARD_OPEN_SIGNUP=true
NEXT_PUBLIC_WARD_API_BASE_URL=
