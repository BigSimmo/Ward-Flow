# Fill only a private copy outside the checkout. This template contains no credentials.
WARD_DATABASE_PROVIDER=supabase
WARD_AUTH_PROVIDER=supabase
WARD_SHARED_ENABLED=true
# Demo controls (advance clock, reset or set scenario) on the shared board. Off unless true.
WARD_SHARED_DEMO_EVENTS=false
WARD_DATA_MODE=prototype
WARD_SUPABASE_PROJECT_REF=zakzoemeedfepxcstsou
WARD_SUPABASE_URL=https://zakzoemeedfepxcstsou.supabase.co
# Supply the restricted wardflow_backend session-pooler URL privately.
WARD_SUPABASE_DATABASE_URL=
# Administrator migration CLI only (npm --prefix backend/ward-flow run migrate:supabase); omit at runtime:
# WARD_SUPABASE_MIGRATION_DATABASE_URL=
WARD_SUPABASE_PUBLISHABLE_KEY=
WARD_SUPABASE_CA_CERT_FILE=
WARD_COORDINATOR_USER_IDS=
WARD_WORKSPACE_ID=
WARD_ALLOWED_ORIGIN=
# Proxies whose X-Real-IP or X-Forwarded-For give the client address, comma separated.
# Use * on a host reachable only through its proxy (Railway). Leave empty when clients connect directly.
WARD_TRUSTED_PROXY_ADDRESSES=
HOST=127.0.0.1
PORT=8791
