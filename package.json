{
  "name": "ward-flow",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "node scripts/dev-free-port.mjs",
    "preinstall": "node scripts/check-node-engine.cjs",
    "postinstall": "node scripts/check-installed-lock-parity.mjs --write-stamp && node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "setup:codex-worktree": "node scripts/setup-codex-worktree.mjs",
    "guard:push": "node scripts/guard-push.mjs",
    "guard:push:self-test": "node scripts/guard-push.mjs --self-test",
    "check:ward-expected-reds": "node scripts/check-ward-expected-reds.mjs",
    "check:ward-text-size": "node scripts/ward-flow/check-text-size-floor.mjs",
    "check:ward-source-control-chars": "node scripts/ward-flow/check-source-control-chars.mjs",
    "check:ward-errata-freshness": "node scripts/ward-flow/check-errata-freshness.mjs",
    "check:ward-citations": "node scripts/check-ward-citations.mjs",
    "check:base-freshness": "node scripts/check-base-freshness.mjs",
    "ensure": "node scripts/ensure-local-server.mjs",
    "build": "node scripts/run-heavy.mjs --npm-script build:internal",
    "build:internal": "node scripts/guard-next-build.mjs && node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build --webpack",
    "check:coverage-inventory": "node scripts/check-coverage-inventory.mjs",
    "start": "node scripts/dev-free-port.mjs start",
    "mutate": "node scripts/ward-flow/mutation-run.mjs",
    "mutate:self-test": "node scripts/ward-flow/mutation-run.mjs --self-test",
    "lint": "node scripts/run-heavy.mjs --npm-script lint:internal",
    "lint:internal": "node --max-old-space-size=8192 ./node_modules/eslint/bin/eslint.js src tests scripts playwright eslint.config.mjs next.config.ts playwright.config.ts vitest.config.mts --max-warnings 0 --no-error-on-unmatched-pattern --cache --cache-location node_modules/.cache/eslint/",
    "lint:changed:internal": "node --max-old-space-size=8192 ./node_modules/eslint/bin/eslint.js",
    "typecheck": "node scripts/run-heavy.mjs --npm-script typecheck:internal",
    "typecheck:internal": "node ./node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:source": "node scripts/run-heavy.mjs --npm-script typecheck:source:internal",
    "typecheck:source:internal": "node ./node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "test": "node scripts/run-vitest.mjs run --reporter=dot",
    "test:backend": "npm --prefix backend/ward-flow run build:engine && npm --prefix backend/ward-flow test",
    "test:related": "node scripts/ward-flow/related-tests.mjs",
    "test:focused": "node scripts/test-focused.mjs",
    "test:live": "node scripts/run-live-tests.mjs",
    "test:coverage": "node scripts/run-vitest.mjs run --coverage --coverage.reportOnFailure=true",
    "bench": "vitest bench --run --config vitest.bench.config.mts",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:pr": "node scripts/run-playwright.mjs --project=chromium --grep-invert \"@quarantine|@mockup\"",
    "check:playwright-browser-revision": "node scripts/check-playwright-browser-revision.mjs",
    "test:e2e:ward-journeys": "node scripts/run-playwright.mjs --project=chromium-mockups ui-ward-",
    "test:e2e:release-gate": "node scripts/run-playwright.mjs --project=release-gate-desktop --project=release-gate-phone",
    "test:e2e:advisory": "node scripts/run-playwright.mjs --project=chromium --project=chromium-mockups --grep \"@quarantine|@mockup\" --pass-with-no-tests",
    "worktrees:report": "node scripts/clean-worktree.mjs",
    "worktrees:inventory": "node scripts/worktree-inventory.mjs",
    "verify:cheap": "npm run verify:cheap:internal",
    "verify:cheap:internal": "npm run docs:check-scripts && npm run docs:check-links && npm run check:installed-lock-parity && npm run check:ci-scope && npm run check:verification-plan && npm run check:diff-integrity && npm run sitemap:check && npm run check:mockups && npm run docs:check-index && npm run docs:check-inventory && npm run check:knip && npm run lint && npm run typecheck && npm run test",
    "verify:pr-local": "node scripts/verify-pr-local.mjs",
    "audit:final-merge": "node scripts/final-merge-audit.mjs",
    "audit:merge-loss": "node scripts/audit-merge-loss.mjs --self-test && node scripts/audit-merge-loss.mjs",
    "verify:ui": "npm run check:installed-lock-parity && npm run test:e2e:pr",
    "verify:release": "npm run check:installed-lock-parity && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "check:knip": "knip --no-progress --include dependencies,unlisted,unresolved,duplicates",
    "check:ci-scope": "node scripts/ci-change-scope.mjs --self-test",
    "check:verification-plan": "node scripts/verify-pr-local.mjs --self-test",
    "check:diff-integrity": "node scripts/check-diff-integrity.mjs --self-test && node scripts/check-diff-integrity.mjs",
    "docs:check-inventory": "node scripts/update-docs-inventory.mjs --check",
    "docs:update": "npm run sitemap:update && node scripts/update-docs-inventory.mjs",
    "docs:check-index": "node scripts/check-codebase-index-coverage.mjs",
    "sitemap:update": "node scripts/run-tsx.mjs scripts/generate-site-map.ts",
    "sitemap:check": "node scripts/run-tsx.mjs scripts/generate-site-map.ts --check",
    "check:installed-lock-parity": "node scripts/check-installed-lock-parity.mjs",
    "format": "node scripts/check-format-changed.mjs --write",
    "format:check": "prettier --check .",
    "format:changed": "node scripts/check-format-changed.mjs",
    "flake:ledger": "node scripts/flake-ledger.mjs",
    "receipts": "node scripts/gate-receipts.mjs status",
    "receipts:clear": "node scripts/gate-receipts.mjs clear",
    "arbiter": "node scripts/gate-arbiter.mjs",
    "arbiter:status": "node scripts/gate-arbiter.mjs status",
    "arbiter:clear": "node scripts/gate-arbiter.mjs clear",
    "sync:pr-branches": "node scripts/sync-open-pr-branches.mjs",
    "sync:pr-branches:apply": "node scripts/sync-open-pr-branches.mjs --apply",
    "check:dead-code-candidate": "node scripts/check-dead-code-candidate.mjs --self-test && node scripts/check-dead-code-candidate.mjs",
    "check:mockups": "node scripts/check-mockup-retirement.mjs --self-test && node scripts/check-mockup-retirement.mjs && node scripts/check-mockup-retirement.mjs --diff auto",
    "check:ward-legal-language": "node scripts/ward-flow/check-ward-legal-language.mjs",
    "ward:reference:build": "node scripts/ward-flow/build-reference-registry.mjs && node scripts/ward-flow/build-reference-distances.mjs && node scripts/ward-flow/build-reference-teams.mjs",
    "check:ward-reference": "node scripts/ward-flow/check-ward-reference.mjs",
    "ward:journey": "node docs/ward-flow/journey/build.mjs",
    "ward:journey:prove": "node docs/ward-flow/journey/build.mjs --prove",
    "ward:organise": "node scripts/ward-flow/organisation.mjs --write-report --source working-tree",
    "ward:organise:check": "node scripts/ward-flow/organisation.mjs --check",
    "ward:dev": "node scripts/ward-flow/dev-with-organisation.mjs",
    "ward:test:sync": "node scripts/ward-flow/design-test-sync.mjs",
    "ward:test:sync:check": "node scripts/ward-flow/design-test-sync.mjs --check",
    "ward:governance:check": "node scripts/ward-flow/check-clinical-governance-gate.mjs",
    "docs:check-scripts": "node scripts/check-docs-script-refs.mjs",
    "check:runtime": "node scripts/run-tsx.mjs scripts/check-runtime.ts",
    "check:type-scale": "node scripts/check-type-scale.mjs --strict",
    "check:icon-scale": "node scripts/check-icon-scale.mjs --strict",
    "check:stale-docs": "node scripts/check-stale-docs.mjs",
    "design-system:token-divergence:update": "node scripts/token-layer-divergences.mjs --write",
    "check:design-system-contract": "node scripts/token-layer-divergences.mjs",
    "test:ci-workflows": "node scripts/run-vitest.mjs run tests/ci-cache-safety.test.ts tests/test-runner-safety.test.ts tests/installed-lock-parity.test.ts tests/ward-backend-ci.test.ts",
    "format:all": "prettier --write .",
    "check:ward-policy-contracts": "node scripts/ward-ci-public/check-policy-contracts.mjs",
    "docs:check-links": "node scripts/check-maintained-doc-links.mjs",
    "docs:maintain": "node scripts/ward-flow/maintain-docs-and-organisation.mjs --write",
    "docs:maintain:check": "node scripts/ward-flow/maintain-docs-and-organisation.mjs --check",
    "docs:facts": "node scripts/doc-facts.mjs",
    "docs:facts:write": "node scripts/doc-facts.mjs --write"
  },
  "dependencies": {
    "@next/env": "16.3.6",
    "lucide-react": "^1.34.0",
    "next": "^16.3.6",
    "postcss": "^8.5.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "esbuild": "0.28.2",
    "sharp": "0.35.5",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.4",
    "brace-expansion@5": "^5.0.12",
    "fast-uri": "^3.1.7",
    "js-yaml": "^4.3.2",
    "undici": "^8.10.2",
    "@codspeed/vitest-plugin": {
      "vite": "^8.2.2"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^8.0.4",
    "@codspeed/vitest-plugin": "^5.7.1",
    "@next/bundle-analyzer": "^16.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.0.1",
    "knip": "^6.32.3",
    "parse5": "8.0.1",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@eslint/eslintrc@3.3.6": true,
    "@humanwhocodes/module-importer@1.0.1": true,
    "@humanfs/node@0.16.8": true,
    "sharp@0.35.5": true
  }
}
