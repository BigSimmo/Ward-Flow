{
  "$comment": "Map between the Figma file and the code. Code is the source of truth. Claude runs the sync through the Figma MCP on Josh's device (Figma Professional has no Code Connect or Variables REST API). Procedure: docs/agents/figma-sync.md. Tokens: scripts/figma-tokens.mjs.",
  "file": {
    "name": "Ward Flow v6 live",
    "url": "https://www.figma.com/design/UfpjjBWlvb3NMp3Nuvktzu"
  },
  "tokens": {
    "css": "src/app/ward-flow-v9-tokens.css",
    "export": "design/figma/tokens.json",
    "collections": {
      "Colour": { "modes": ["Day", "Night"] },
      "Size": { "modes": ["Value"] }
    },
    "naming": {
      "rule": "Figma variable group/name maps to CSS --wf-group-name (each slash becomes a hyphen), for example ink/1 is --wf-ink-1.",
      "codeSyntax": "Every Figma variable sets WEB code syntax to var(--wf-name). Read the CSS name from it rather than rebuilding it from the Figma name.",
      "codeOnly": "Gradients, shadows (--wf-e1 to --wf-e3), backdrop, glass rim, sheen, motion and fonts stay in code. Figma cannot bind them to variables."
    },
    "figmaOnly": {
      "patterns": ["alpha/*", "status/*-tint", "status/*-edge"],
      "note": "Figma helpers. Code derives these with color-mix, so a pull ignores them."
    }
  },
  "components": {
    "Button": { "file": "src/components/wf/button.tsx", "export": "Button" },
    "Badge": { "file": "src/components/wf/badge.tsx", "export": "Badge" },
    "Status glyph": { "file": "src/components/wf/status-glyph.tsx", "export": "StatusGlyph" },
    "Icon button": { "file": "src/components/wf/button.tsx", "export": "Button", "props": "iconOnly" },
    "Stat": { "file": "src/components/wf/stat.tsx", "export": "Stat" },
    "Hero band": { "file": "src/components/wf/hero.tsx", "export": "Hero" },
    "Card": { "file": "src/components/wf/card.tsx", "export": "Card" },
    "Input": { "file": "src/components/wf/form.tsx", "export": "TextInput" },
    "Field": { "file": "src/components/wf/form.tsx", "export": "Field" },
    "Choice": { "file": "src/components/wf/choice.tsx", "export": "FilterChip" },
    "Segmented": { "file": "src/components/wf/choice.tsx", "export": "Segmented" },
    "Tabs": { "file": "src/components/wf/choice.tsx", "export": "Tabs" },
    "Menu": { "file": "src/components/wf/menu.tsx", "export": "Menu" },
    "Toast": { "file": "src/components/wf/toast.tsx", "export": "ToastView" },
    "Live chip": { "file": "src/components/wf/live.tsx", "export": "LiveChip" },
