{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "node --max-old-space-size=8192 node_modules/next/dist/bin/next build --webpack"
  },
  "deploy": {
    "startCommand": "node node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/health"
  }
}
