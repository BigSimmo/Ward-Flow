<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="WardFlow_PatientJourney"
                  targetNamespace="http://wardflow.local/patient-journey">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_1" name="The patient's journey through Ward Flow" processRef="Process_journey" />
  </bpmn:collaboration>
  <bpmn:process id="Process_journey" name="Ward Flow — the patient's journey" isExecutable="false">
    <bpmn:startEvent id="Start_referral" name="A referral is raised" />
    <bpmn:task id="Task_address" name="Address it to up to three places at once" />
    <bpmn:exclusiveGateway id="Gw_answer" name="How does each place answer?" />
    <bpmn:endEvent id="End_declined" name="Declined everywhere — the person stops moving" />
    <bpmn:endEvent id="End_withdrawn" name="The referrer withdraws" />
    <bpmn:task id="Task_accepted" name="A ward accepts" />
    <bpmn:task id="Task_movement" name="A movement is created — this is what moves" />
    <bpmn:task id="Task_askWards" name="Ask one or more wards" />
    <bpmn:exclusiveGateway id="Gw_ward" name="Does a ward take the patient?" />
    <bpmn:task id="Task_declined" name="A ward declines — seven reasons" />
    <bpmn:endEvent id="End_abandoned" name="Bed search abandoned — did not proceed" />
    <bpmn:task id="Task_community" name="Sent to a community team instead" />
    <bpmn:task id="Task_inPrinciple" name="A ward accepts in principle" />
    <bpmn:task id="Task_pull" name="Pull and hold a named bed" />
    <bpmn:task id="Task_releasePull" name="Give the held bed back — four reasons" />
    <bpmn:exclusiveGateway id="Gw_transport" name="Is transport needed?" />
    <bpmn:task id="Task_book" name="Book transport — five answers, none defaulted" />
    <bpmn:task id="Task_cancel" name="Cancel before collection — four reasons" />
    <bpmn:task id="Task_handover" name="Handover ready" />
    <bpmn:task id="Task_enroute" name="The crew accepts and sets off" />
    <bpmn:task id="Task_collect" name="The patient is collected" />
    <bpmn:task id="Task_stop" name="Stop the journey — say where they now are" />
    <bpmn:endEvent id="End_heldBed" name="Movement closed, bed still held" />
    <bpmn:task id="Task_arrive" name="The ward confirms they have arrived" />
    <bpmn:task id="Task_onWard" name="On the ward" />
    <bpmn:task id="Task_away" name="Away at an ED, or on leave — bed kept" />
    <bpmn:task id="Task_ready" name="Clinically ready to leave" />
    <bpmn:parallelGateway id="Gw_split" name="Two tracks, joined by nothing" />
    <bpmn:task id="Task_leaves" name="The person leaves — eight recorded ways" />
    <bpmn:task id="Task_bedFree" name="The bed is released — expected, confirmed, discharged" />
    <bpmn:endEvent id="End_gone" name="Gone" />
    <bpmn:endEvent id="End_bedFree" name="Bed counted as available" />
    <bpmn:endEvent id="End_absconds" name="Nothing can record this" />
    <bpmn:boundaryEvent id="Bnd_revoked" name="Legal authority revoked — collection refused while a bed is held" attachedToRef="Task_enroute" cancelActivity="true">
      <bpmn:errorEventDefinition id="Bnd_revoked_def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_absconds" name="The patient absconds — NO RECORD EXISTS" attachedToRef="Task_onWard" cancelActivity="true">
      <bpmn:errorEventDefinition id="Bnd_absconds_def" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_referral" targetRef="Task_address" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_address" targetRef="Gw_answer" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gw_answer" targetRef="End_declined" name="Declined by all" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gw_answer" targetRef="End_withdrawn" name="Referrer withdraws" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gw_answer" targetRef="Task_accepted" name="A ward says yes" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_accepted" targetRef="Task_movement" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_movement" targetRef="Task_askWards" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_askWards" targetRef="Gw_ward" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gw_ward" targetRef="Task_declined" name="No" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_declined" targetRef="Task_askWards" name="ask another" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_ward" targetRef="End_abandoned" name="Search abandoned" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gw_ward" targetRef="Task_inPrinciple" name="Yes" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_askWards" targetRef="Task_community" name="Community instead" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_community" targetRef="End_abandoned" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_inPrinciple" targetRef="Task_pull" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_pull" targetRef="Task_releasePull" name="Given back" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_releasePull" targetRef="Task_inPrinciple" name="back to awaiting a bed" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_pull" targetRef="Gw_transport" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gw_transport" targetRef="Task_arrive" name="None needed" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gw_transport" targetRef="Task_book" name="Yes" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_book" targetRef="Task_cancel" name="Cancelled" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_cancel" targetRef="Task_pull" name="bed still held" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_book" targetRef="Task_handover" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_handover" targetRef="Task_enroute" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_enroute" targetRef="Task_collect" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_collect" targetRef="Task_arrive" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_stop" targetRef="End_heldBed" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_arrive" targetRef="Task_onWard" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_onWard" targetRef="Task_away" name="Temporarily" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_away" targetRef="Task_onWard" name="returns" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_onWard" targetRef="Task_ready" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_ready" targetRef="Gw_split" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gw_split" targetRef="Task_leaves" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Gw_split" targetRef="Task_bedFree" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_leaves" targetRef="End_gone" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_bedFree" targetRef="End_bedFree" />
    <bpmn:sequenceFlow id="Flow_b1" sourceRef="Bnd_revoked" targetRef="Task_stop" />
    <bpmn:sequenceFlow id="Flow_b2" sourceRef="Bnd_absconds" targetRef="End_absconds" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_journey">
