#!/bin/sh
# Ward Flow fold-lock guard (owner rule, 25 September 2026).
#
# Refuses any change to the Ward Flow line (a commit, merge, reset, `branch -f`, rename or
# deletion of codex/task-ward-flow-live-state-20260831) unless the fold lock is held:
#   node scripts/ward-flow/fold-lock.mjs acquire "<thread name>"
# The lock is the folder <git common dir>/ward-fold.lock, shared by every worktree.
#
# Owner override, for Josh only: set WARD_FOLD_OVERRIDE=1 for that one command, e.g.
#   WARD_FOLD_OVERRIDE=1 git merge --no-ff <branch>
#
# Git runs this hook for every reference update; it only acts in the "prepared" state, and
# only when the ward line's value actually changes, so fetches, other branches and ref
# packing pass straight through.
[ "$1" = "prepared" ] || exit 0

ward_ref=refs/heads/codex/task-ward-flow-live-state-20260831
touched=
common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common_dir=
while read -r old new ref; do
  [ "$ref" = "$ward_ref" ] || continue
  # A deletion arrives as an all-zero new value (and often an all-zero old value too).
  case "$new" in
    *[!0]*) ;;
    *)
      # Ref packing (git gc) first copies the ref into packed-refs, then removes the loose
      # file as "<old> -> zero". That is not a change to the line, so let it through.
      case "$old" in
        *[!0]*)
          if [ -n "$common_dir" ] && grep -qx "$old $ward_ref" "$common_dir/packed-refs" 2>/dev/null &&
            [ "$old" = "$(git rev-parse -q --verify "$ward_ref" 2>/dev/null)" ]; then
            continue
          fi
          ;;
      esac
      touched=1
      continue
      ;;
  esac
  # Git leaves the old value zero when it has not read it, so compare with the ref's real
  # value: ref packing rewrites the same value and is not a change to the line.
  [ "$new" = "$(git rev-parse -q --verify "$ward_ref" 2>/dev/null)" ] && continue
  touched=1
done
[ -n "$touched" ] || exit 0

if [ "${WARD_FOLD_OVERRIDE:-}" = "1" ]; then
  echo "ward fold guard: owner override used, the Ward Flow line was changed without the fold lock." >&2
  exit 0
fi

if [ -n "$common_dir" ] && [ -d "$common_dir/ward-fold.lock" ]; then
  exit 0
fi

cat >&2 <<'EOF'
ward fold guard: refused. The Ward Flow line (codex/task-ward-flow-live-state-20260831) can only
change while the fold lock is held. Take it first:
  node scripts/ward-flow/fold-lock.mjs acquire "<thread name>"
then follow the fold sequence in docs/ward-flow/HOW-WE-WORK.md section 4, and release the lock after.
Only Josh may bypass this, with WARD_FOLD_OVERRIDE=1 on the one command.
EOF
exit 1
