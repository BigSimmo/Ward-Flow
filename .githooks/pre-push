#!/bin/sh
# Pre-push safety net. The script first verifies that Git's actual destination
# is BigSimmo/Ward-Flow, then checks auto-merge ownership, in-flight CI, pushed
# blob formatting, and the static gate. Destination identity and the armed
# auto-merge force-push block have no override. Other guards have scoped flags.
#
# Installed by scripts/install-git-hooks.mjs via `git config core.hooksPath
# .githooks` (run automatically on npm install/ci). Git passes the pushed refs
# on stdin as "<localRef> <localSha> <remoteRef> <remoteSha>" lines, which the
# script reads to scope the format and static checks to what is
# actually pushed.
#
# GUARD_PUSH_DISABLE=1 skips CI, format and static checks only. It cannot skip
# destination identity or auto-merge ownership.
set -eu

if [ "${GUARD_PUSH_DISABLE:-}" = "1" ]; then
  export SKIP_IN_FLIGHT_CI_GUARD=1
  export SKIP_FORMAT_GUARD=1
  export SKIP_STATIC_GUARD=1
fi

# Without Node, the destination cannot be checked, so block the push.
if ! command -v node >/dev/null 2>&1; then
  echo "[pre-push] node not found on PATH — cannot verify Ward-Flow push destination" >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
exec node "$repo_root/scripts/guard-push.mjs" "$@"
